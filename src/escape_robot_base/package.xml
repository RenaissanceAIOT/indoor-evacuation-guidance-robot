<?xml version="1.0"?>
<package format="3">
  <name>escape_robot_base</name>
  <version>0.1.0</version>
  <description>ROS 2 serial driver for the laboratory omnidirectional mobile base.</description>
  <maintainer email="166830931+RenaissanceAIOT@users.noreply.github.com">RenaissanceAIOT</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
